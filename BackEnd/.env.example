# --- Municipality Configuration ---
DEFAULT_MUNICIPALITY_LANGUAGE=ca
SUPPORTED_LANGUAGES=ca,es,en

# --- Database Configuration (for Spring Boot) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/promorural
SPRING_DATASOURCE_USERNAME=promorural
SPRING_DATASOURCE_PASSWORD=promorural

# --- Database Configuration (for Docker Compose) ---
POSTGRES_DB=promorural
POSTGRES_USER=promorural
POSTGRES_PASSWORD=promorural

# --- Security (JWT) ---
# Use a secure, random string of at least 32 characters
JWT_SECRET=change-this-secret-key-with-a-very-long-random-string
JWT_EXPIRATION_MS=86400000

# --- Initial Seed Data ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234
SEED_MERCHANT_USERNAME=merchant
SEED_MERCHANT_PASSWORD=merchant1234
