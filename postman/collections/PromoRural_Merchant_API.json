        {
          "name": "Create Promotion",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "const future = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);",
                  "pm.environment.set('currentDate', now.toISOString());",
                  "pm.environment.set('futureDate', future.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create promotion returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const responseJson = pm.response.json();",
                  "pm.test('created promotion has id', function () {",
                  "  pm.expect(responseJson.id).to.exist;",
                  "});",
                  "pm.environment.set('promotionIdToDelete', responseJson.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": {\n    \"ca\": \"Promocio test\",\n    \"es\": \"Promocion test\",\n    \"en\": \"Test promotion\"\n  },\n  \"description\": {\n    \"ca\": \"Descripcio test\",\n    \"es\": \"Descripcion test\",\n    \"en\": \"Test description\"\n  },\n  \"startsAt\": \"{{currentDate}}\",\n  \"endsAt\": \"{{futureDate}}\",\n  \"imageUrl\": \"https://example.com/images/test.jpg\"\n}",
              "options": {
