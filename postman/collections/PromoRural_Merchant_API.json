{
  "info": {
    "_postman_id": "generated-merchant-collection-20240509-revised",
    "name": "PromoRural Merchant API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response status is not a server error', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Merchant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requestBody = {",
                  "  username: pm.environment.get('merchantUsername') || pm.collectionVariables.get('merchantUsername'),",
                  "  password: pm.environment.get('merchantPassword') || pm.collectionVariables.get('merchantPassword')",
                  "};",
                  "pm.request.body.update(JSON.stringify(requestBody));",
                  "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const responseJson = pm.response.json();",
                  "pm.test('JWT token received', function () {",
                  "  pm.expect(responseJson.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('jwtToken', responseJson.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
